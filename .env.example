# Optional. Copy to .env (git-ignored) only if you want narration. Never commit real values.
# Narration is off by default: silent and SFX-only videos need none of this.
# ElevenLabs is used only after the audio gate, with a cost estimate first.
ELEVENLABS_API_KEY=
# ID of the voice to use (ElevenLabs > Voices > your voice > ID)
ELEVENLABS_VOICE_ID=
# Optional: model id; default eleven_multilingual_v2 (flash/turbo models cost half)
ELEVENLABS_MODEL_ID=
# Optional: hard cap for one narration run, in US dollars (default 1)
ELEVENLABS_MAX_USD=1
